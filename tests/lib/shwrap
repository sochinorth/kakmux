#!/bin/sh
# shwrap: counting KAKOUNE_POSIX_SHELL. One line per shell kak starts, in
# $KM_SHLOG: the script's start, less the double() helper many scripts begin with.
printf "%s\n" "$(printf %s "$2" | tr "\n\t" "  " | tr -s ' ' | sed 's/^ *double() { r= rest=$2 while :; do case $rest in \*"$1"\*) r="$r${rest%%"$1"\*}$1$1" rest=${rest#\*"$1"} ;; \*) r=$r$rest; return ;; esac done } *//' | cut -c1-160)" >> "${KM_SHLOG:?}"
exec /bin/sh "$@"
