#!/bin/sh
# Left pane of kakbr: runs broot at kakbr.conf's sidebar width (@kakbr_width:
# 25% of the window, within 24..40 columns). kakbr.conf's hook sets it as the
# window resizes; this sets it once kak's pane is beside it, and snaps it
# into 24..40 when it's resized by hand (dragging the border).
pane=${TMUX_PANE:?kakbr-sidebar: not inside tmux}
tmux set-option -w -t "$pane" @kakbr_side "$pane"

last=
fit() {
	set -- $(tmux display-message -p -t "$pane" \
		'#{pane_width} #{window_width} #{window_panes} #{E:@kakbr_width} #{@kakbr_min} #{@kakbr_max} #{pane_floating_flag}') || return
	w=$1 now="$2 $3"
	[ "$7" = 0 ] || return                      # floated (kakbr/float): its own size
	[ "$3" -ge 2 ] || { last=$now; return; }    # alone: nothing to size against
	if [ "$now" = "$last" ]; then
		want=$(( w < $5 ? $5 : w > $6 ? $6 : w ))   # by hand: the window is as it was
	else
		want=$4
	fi
	last=$now
	[ "$w" = "$want" ] || tmux resize-pane -t "$pane" -x "$want"
}

# broot runs as a child (no job control, so it stays in the terminal's
# foreground process group) and this shell gets every SIGWINCH alongside it.
# KAKBR_SESSION (from kakbr) tells broot-open it's the sidebar; the opener dir
# routes double-click there. kakbr's broot.hjson (the main config, git on)
# when it's there.
conf=${XDG_CONFIG_HOME:-$HOME/.config}/kakbr/broot.hjson
[ -e "$conf" ] && set -- --conf "$conf" "$@"
# Its git marks kept current: broot's watch (:toggle_watch, as alt-w) redraws
# the tree when a file under it changes; what it misses (a commit or git add
# touches only .git) kakbr.conf's focus hooks send it as :refresh, through
# this server (--listen, named after kak's session, @kakbr_broot). Its
# socket is /tmp/broot-server-NAME.sock whatever TMPDIR, left behind when
# broot is killed (with kakbr): removed here. broot refuses to start on a
# name a live one has (a dead one's socket it replaces): then it does
# without.
name=$KAKBR_SESSION sock=/tmp/broot-server-$KAKBR_SESSION.sock
if [ -n "$name" ] && ! { [ -S "$sock" ] && broot --send "$name" --get-root >/dev/null 2>&1; }; then
	set -- --listen "$name" "$@"
	tmux set-option -g @kakbr_broot "$name"
	trap 'rm -f "$sock"' EXIT
	trap 'exit 129' HUP
	trap 'exit 143' TERM
fi
PATH="$HOME/.local/lib/broot-opener:$PATH" broot --cmd :toggle_watch "$@" </dev/tty >/dev/tty &
pid=$!

# The trap only flags; fit runs here, so the resize it causes (another
# SIGWINCH, the width then already right) is handled by the next pass rather
# than re-entering it.
resized=1
trap 'resized=1' WINCH
while :; do
	while [ -n "$resized" ]; do resized=; fit >/dev/null 2>&1; done
	wait "$pid"; status=$?          # returns early when SIGWINCH arrives
	kill -0 "$pid" 2>/dev/null || exit "$status"
done
