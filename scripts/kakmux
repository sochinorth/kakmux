#!/bin/sh
# kakmux [kak args]: Kakoune in its own tmux server (kakmux-PID), whose status
# line is the bufferline (see rc/bufferline.kak). It ends with its
# terminal (or pane), as plain kak does: detached, its server would linger
# unseen.
# Inside another tmux it nests, as one pane there with its splits and
# bufferline inside; at its edges, kak's <c-w> h/j/k/l move on to the panes
# around it (@outer_pane, see split-focus in rc/splits.kak). Inside a
# kakmux, plain kak.
# Windows' system dirs (WSL's /mnt/c/Windows/...) are left off kak's PATH:
# its shell completion (:sh, :pipe) checks every file on PATH, thousands
# there, each a slow trip to Windows' filesystem (some 0.6 s a time).
p= IFS=:
set -f
for d in $PATH; do
	case $d in /mnt/?/[Ww][Ii][Nn][Dd][Oo][Ww][Ss] | /mnt/?/[Ww][Ii][Nn][Dd][Oo][Ww][Ss]/*) ;; *) p=${p:+$p:}$d ;; esac
done
set +f; unset IFS
PATH=$p
case ${TMUX%%,*} in */kakmux-*) exec kak "$@" ;; esac

set -- kak "$@" \; set-option destroy-unattached on
[ -z "$TMUX" ] || set -- "$@" \; set-option @outer_pane "${TMUX%%,*} $TMUX_PANE"
TMUX= exec tmux -L "kakmux-$$" -f ~/.config/kak/kakmux.conf new-session -- "$@"
